# ==============================================================================
# Voz do Bairro - Variáveis de Ambiente de Exemplo
# Copie este arquivo para .env na raiz ou nas pastas backend/frontend
# ==============================================================================

# Backend Config
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL com extensão PostGIS)
DATABASE_URL=postgresql://voz_user:voz_secret_password@localhost:5432/voz_do_bairro
DB_HOST=localhost
DB_PORT=5432
DB_USER=voz_user
DB_PASSWORD=voz_secret_password
DB_NAME=voz_do_bairro

# Autenticação JWT
JWT_SECRET=super_secret_jwt_key_voz_do_bairro_change_in_production_2026_xYz
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=60000

# Armazenamento e Uploads de Imagens
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# Frontend Config
VITE_API_URL=http://localhost:3001/api/v1
