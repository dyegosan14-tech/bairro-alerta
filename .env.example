# ==============================================================================
# Voz do Bairro - Variáveis de Ambiente de Exemplo
# Copie este arquivo para .env na raiz ou nas pastas backend/frontend
# ==============================================================================

# Backend Config
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
# Origem(ns) permitida(s) para CORS. '*' libera qualquer origem (sem credenciais).
# Em produção, defina o domínio real do frontend (ou uma lista separada por vírgulas).
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL com extensão PostGIS)
# DATABASE_URL é a ÚNICA variável que o backend (Node) lê para conectar ao banco.
DATABASE_URL=postgresql://voz_user:voz_secret_password@localhost:5432/voz_do_bairro

# As três variáveis abaixo NÃO são lidas pelo backend Node — servem apenas para o
# docker-compose.yml configurar o container do Postgres (POSTGRES_USER/PASSWORD/DB) e montar
# a DATABASE_URL do container do backend. Ao rodar sem Docker, ignore-as e edite DATABASE_URL
# diretamente acima. Troque a senha padrão ao subir qualquer ambiente real.
DB_USER=voz_user
DB_PASSWORD=voz_secret_password
DB_NAME=voz_do_bairro

# Autenticação JWT
# ATENÇÃO: o valor abaixo é só para desenvolvimento local. Em produção (NODE_ENV=production)
# a aplicação recusa iniciar se JWT_SECRET for este valor de exemplo ou tiver menos de 32
# caracteres — gere um segredo forte e exclusivo (ex.: `openssl rand -hex 32`) e nunca o
# reutilize entre ambientes.
JWT_SECRET=dev_only_insecure_default_jwt_secret_do_not_use_in_production
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=60000

# Armazenamento e Uploads de Imagens
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# Frontend Config
VITE_API_URL=http://localhost:3001/api/v1
